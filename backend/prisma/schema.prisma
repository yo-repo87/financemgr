generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  // Nullable - an OAuth-only account (Google/Apple) has no password until the
  // user optionally sets one later (the password-reset "complete" step doubles
  // as "set a password" for such accounts, with no special-casing needed).
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  plaidItems        PlaidItem[]
  budgets           Budget[]
  aiSetting         AiSetting?
  aiMessages        AiMessage[]
  refreshTokens     RefreshToken[]
  balanceSnapshots  BalanceSnapshot[]
  webauthnCredentials WebAuthnCredential[]
  twoFactorSetting  TwoFactorSetting?
  backupCodes       BackupCode[]
  securityQuestions SecurityQuestion[]
  oauthAccounts     OAuthAccount[]
  bills             Bill[]
  billPayments      BillPayment[]
  pushSubscriptions PushSubscription[]
  notificationSetting NotificationSetting?
  detectedSubscriptions DetectedSubscription[]
  categoryOverrides CategoryOverride[]
  detectedIncomes   DetectedIncome[]
  cashFlowSetting   CashFlowSetting?
  savingsGoals      SavingsGoal[]

  @@map("users")
}

// A user's own correction of a merchant's category, applied to future synced
// transactions from the same merchant (see plaidSync.ts) since Plaid's
// auto-categorization isn't always right and re-fixing it every sync is tedious.
model CategoryOverride {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  merchantKey String   @map("merchant_key")
  category    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@map("category_overrides")
}

enum IncomeStatus {
  NEW
  DISMISSED
  CONFIRMED
}

// Mirrors DetectedSubscription but for recurring deposits (paychecks, etc) -
// feeds the cash flow forecast once a user marks one CONFIRMED.
model DetectedIncome {
  id               String       @id @default(uuid())
  userId           String       @map("user_id")
  merchantKey      String       @map("merchant_key")
  displayName      String       @map("display_name")
  amount           Decimal      @db.Decimal(14, 2)
  cadenceDays      Int          @map("cadence_days")
  lastReceivedDate DateTime     @map("last_received_date") @db.Date
  occurrenceCount  Int          @map("occurrence_count")
  status           IncomeStatus @default(NEW)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("detected_incomes")
}

model CashFlowSetting {
  userId             String   @id @map("user_id")
  lowBalanceThreshold Decimal @default(0) @map("low_balance_threshold") @db.Decimal(14, 2)
  updatedAt          DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("cash_flow_settings")
}

// Dedups the daily low-balance push so it fires once per newly-identified dip,
// not once every day the same projected low point is still in the window.
model CashFlowAlertSent {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  alertDate DateTime @map("alert_date") @db.Date
  sentAt    DateTime @default(now()) @map("sent_at")

  @@unique([userId, alertDate])
  @@map("cash_flow_alerts_sent")
}

model SavingsGoal {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  targetAmount Decimal @map("target_amount") @db.Decimal(14, 2)
  targetDate DateTime? @map("target_date") @db.Date
  active     Boolean   @default(true)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_goals")
}

// Manual contribution log, not derived from a linked account balance - a goal
// isn't realistically "its own" Plaid account, so progress is self-reported
// the same way Bill payments are.
model SavingsContribution {
  id     String   @id @default(uuid())
  goalId String   @map("goal_id")
  amount Decimal  @db.Decimal(14, 2)
  date   DateTime @db.Date
  note   String?
  createdAt DateTime @default(now()) @map("created_at")

  goal SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("savings_contributions")
}

// A holding within a Plaid investment account - denormalized (no separate
// Security table) to keep the sync loop in plaidSync.ts to one pass.
model Holding {
  id           String   @id @default(uuid())
  accountId    String   @map("account_id")
  securityId   String   @map("security_id")
  symbol       String?
  name         String
  quantity     Decimal  @db.Decimal(20, 8)
  costBasis    Decimal? @map("cost_basis") @db.Decimal(14, 2)
  currentPrice Decimal? @map("current_price") @db.Decimal(14, 4)
  currentValue Decimal? @map("current_value") @db.Decimal(14, 2)
  updatedAt    DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, securityId])
  @@map("holdings")
}

enum SubscriptionStatus {
  NEW
  DISMISSED
  TRACKED
}

// A candidate recurring subscription found by scanning transaction history
// (backend/src/lib/subscriptionDetection.ts) - distinct from Bill, which is
// something the user has already told the app about. Re-running detection
// updates NEW rows in place but never touches one the user has already acted
// on (DISMISSED/TRACKED), so their decision sticks.
model DetectedSubscription {
  id              String             @id @default(uuid())
  userId          String             @map("user_id")
  merchantKey     String             @map("merchant_key")
  displayName     String             @map("display_name")
  amount          Decimal            @db.Decimal(14, 2)
  lastChargedDate DateTime           @map("last_charged_date") @db.Date
  occurrenceCount Int                @map("occurrence_count")
  status          SubscriptionStatus @default(NEW)
  notifiedAt      DateTime?          @map("notified_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantKey])
  @@index([userId])
  @@map("detected_subscriptions")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Master switch checked before sending to any of a user's subscriptions -
// toggling this off/on doesn't touch browser permission state, so re-enabling
// needs no re-subscribe (see backend/src/lib/push.ts).
model NotificationSetting {
  userId      String   @id @map("user_id")
  pushEnabled Boolean  @default(true) @map("push_enabled")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_settings")
}

enum BillRecurrence {
  ONE_TIME
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

// A bill is a recurring definition, not a per-cycle record - due dates are
// computed on read from anchorDueDate + recurrence (see lib/billing.ts).
// Whether a given cycle is paid is represented by BillPayment row presence,
// not a flag, so nothing needs to pre-generate future cycles.
model Bill {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  name              String
  amount            Decimal        @db.Decimal(14, 2)
  category          String?
  recurrence        BillRecurrence
  anchorDueDate     DateTime       @map("anchor_due_date") @db.Date
  // Matches against transaction name/merchant (case-insensitive) to
  // auto-mark a cycle paid from synced Plaid data - e.g. "flex" for
  // Flex rent-split withdrawals. Null/empty means manual-only.
  autoDetectKeyword String?        @map("auto_detect_keyword")
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments BillPayment[]
  reminders BillReminderSent[]

  @@index([userId])
  @@map("bills")
}

enum BillReminderKind {
  UPCOMING
  OVERDUE
}

// Guards the daily reminder job (backend/src/jobs/billReminders.ts) from
// re-notifying the same cycle every time it runs - one row per (bill, cycle,
// kind) ever sent, not per user, since a bill already scopes to one user.
model BillReminderSent {
  id      String           @id @default(uuid())
  billId  String           @map("bill_id")
  dueDate DateTime         @map("due_date") @db.Date
  kind    BillReminderKind
  sentAt  DateTime         @default(now()) @map("sent_at")

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, dueDate, kind])
  @@map("bill_reminders_sent")
}

model BillPayment {
  id            String    @id @default(uuid())
  billId        String    @map("bill_id")
  userId        String    @map("user_id")
  dueDate       DateTime  @map("due_date") @db.Date
  paidAt        DateTime? @map("paid_at")
  amountPaid    Decimal?  @map("amount_paid") @db.Decimal(14, 2)
  // Set only when auto-matched from a synced transaction - distinguishes
  // "Auto-detected" from "Marked paid manually" in the UI. SetNull (not
  // Cascade) so a removed/re-synced transaction doesn't delete payment history.
  transactionId String?   @map("transaction_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  bill        Bill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([billId, dueDate])
  @@index([userId])
  @@map("bill_payments")
}

enum OAuthProvider {
  GOOGLE
  APPLE
}

model OAuthAccount {
  id                String        @id @default(uuid())
  userId            String        @map("user_id")
  provider          OAuthProvider
  providerAccountId String        @map("provider_account_id")
  email             String
  createdAt         DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// questionId references the fixed pool in backend/src/lib/securityQuestions.ts,
// not a DB row - the pool is small, curated, and shared by every user so the
// password-reset flow can serve indistinguishable decoy questions for unknown
// emails (see backend/src/routes/passwordReset.ts).
model SecurityQuestion {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  answerHash String   @map("answer_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@map("security_questions")
}

enum CredentialPurpose {
  PASSKEY
  SECOND_FACTOR
}

// A single WebAuthn credential table serving two distinct roles, tagged by
// `purpose` at registration time: PASSKEY credentials are registered as
// discoverable/resident keys and can log a user in without a password.
// SECOND_FACTOR credentials are only ever challenged after a password has
// already been verified (see TwoFactorSetting).
model WebAuthnCredential {
  id           String            @id @default(uuid())
  userId       String            @map("user_id")
  credentialId String            @unique @map("credential_id")
  publicKey    String            @map("public_key")
  counter      Int               @default(0)
  transports   String[]
  purpose      CredentialPurpose
  nickname     String?
  createdAt    DateTime          @default(now()) @map("created_at")
  lastUsedAt   DateTime?         @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model TwoFactorSetting {
  userId              String   @id @map("user_id")
  totpSecretEncrypted String?  @map("totp_secret_encrypted")
  totpEnabled          Boolean  @default(false) @map("totp_enabled")
  updatedAt            DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("two_factor_settings")
}

// One-time recovery codes for when TOTP/security-key 2FA is unavailable.
// Hashed with the same sha256 helper used for refresh tokens - appropriate
// here since these are high-entropy random codes, not user-chosen secrets.
model BackupCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")
  usedAt    DateTime? @map("used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("backup_codes")
}

// One row per user per day, recorded whenever a Plaid sync completes, so the
// analytics dashboard can chart real net-worth history as it accumulates over time.
model BalanceSnapshot {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime @db.Date
  netWorth  Decimal  @map("net_worth") @db.Decimal(14, 2)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("balance_snapshots")
}

// Hashed refresh tokens so a stolen DB row can't be replayed as a session directly.
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PlaidItem {
  id                  String    @id @default(uuid())
  userId              String    @map("user_id")
  plaidItemId         String    @unique @map("plaid_item_id")
  accessTokenEncrypted String   @map("access_token_encrypted")
  institutionName     String?   @map("institution_name")
  status              String    @default("active")
  cursor              String?
  lastSyncedAt        DateTime? @map("last_synced_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
  @@map("plaid_items")
}

model Account {
  id               String   @id @default(uuid())
  plaidItemId      String   @map("plaid_item_id")
  plaidAccountId   String   @unique @map("plaid_account_id")
  name             String
  mask             String?
  type             String
  subtype          String?
  currentBalance   Decimal? @map("current_balance") @db.Decimal(14, 2)
  availableBalance Decimal? @map("available_balance") @db.Decimal(14, 2)
  creditLimit      Decimal? @map("credit_limit") @db.Decimal(14, 2)
  isoCurrencyCode  String?  @map("iso_currency_code")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  plaidItem        PlaidItem         @relation(fields: [plaidItemId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  creditCardDetail CreditCardDetail?
  holdings         Holding[]

  @@index([plaidItemId])
  @@map("accounts")
}

// Sourced from Plaid /liabilities/get. Plaid does not guarantee a forward-looking
// "next closing date" field, so estimatedNextClosingDate is computed (last statement
// issue date + ~1 statement cycle) and must be surfaced in the UI as an estimate.
model CreditCardDetail {
  accountId               String    @id @map("account_id")
  lastStatementIssueDate  DateTime? @map("last_statement_issue_date") @db.Date
  estimatedNextClosingDate DateTime? @map("estimated_next_closing_date") @db.Date
  lastStatementBalance    Decimal?  @map("last_statement_balance") @db.Decimal(14, 2)
  minimumPaymentAmount    Decimal?  @map("minimum_payment_amount") @db.Decimal(14, 2)
  nextPaymentDueDate      DateTime? @map("next_payment_due_date") @db.Date
  lastPaymentAmount       Decimal?  @map("last_payment_amount") @db.Decimal(14, 2)
  // From Plaid's card.aprs (the purchase_apr entry) - powers the debt payoff
  // planner's interest simulation. Null for cards Plaid doesn't report an APR for.
  aprPercentage           Decimal?  @map("apr_percentage") @db.Decimal(5, 2)
  updatedAt                DateTime  @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("credit_card_details")
}

model Transaction {
  id                String   @id @default(uuid())
  accountId         String   @map("account_id")
  plaidTransactionId String  @unique @map("plaid_transaction_id")
  amount            Decimal  @db.Decimal(14, 2)
  isoCurrencyCode   String?  @map("iso_currency_code")
  date              DateTime @db.Date
  name              String
  merchantName      String?  @map("merchant_name")
  category          String?
  pending           Boolean  @default(false)
  createdAt         DateTime @default(now()) @map("created_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  billPayments BillPayment[]

  @@index([accountId, date])
  @@index([category])
  @@map("transactions")
}

model Budget {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  category    String
  monthlyLimit Decimal @map("monthly_limit") @db.Decimal(14, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("budgets")
}

model AiSetting {
  userId              String   @id @map("user_id")
  openaiApiKeyEncrypted String? @map("openai_api_key_encrypted")
  openaiKeyLastFour   String?  @map("openai_key_last_four")
  modelPreference     String   @default("gpt-4o-mini") @map("model_preference")
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ai_settings")
}

// Chat content is encrypted at rest since advisor conversations reference real balances/spending.
model AiMessage {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  role             String
  contentEncrypted String   @map("content_encrypted")
  createdAt        DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_messages")
}
