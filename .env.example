# --- Database ---
DB_USER=financemgr
DB_PASSWORD=change_me_generate_a_strong_random_value
DB_NAME=financemgr
DATABASE_URL=postgresql://financemgr:change_me_generate_a_strong_random_value@db:5432/financemgr?sslmode=require

# --- Auth secrets ---
# Generate each with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=

# --- Field-level encryption key (AES-256-GCM, 32 bytes base64) ---
# Generate with: openssl rand -base64 32
# Protects Plaid access tokens, per-user OpenAI keys, and AI chat history at rest.
# Losing this key makes encrypted data unrecoverable - back it up somewhere safe, outside git.
ENCRYPTION_KEY=

# --- Plaid (Sandbox) ---
# Free instant signup: https://dashboard.plaid.com/signup
# Sandbox keys work immediately with no approval; test login is user_good / pass_good.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# --- App URLs ---
# If accessing from another device on your LAN, change both to your host's LAN IP
# (e.g. http://192.168.x.x:3140 / :3141) and rebuild (VITE_API_URL is baked in at build time).
FRONTEND_URL=http://localhost:3140
VITE_API_URL=http://localhost:3141
BACKEND_PORT=4000
NODE_ENV=production
